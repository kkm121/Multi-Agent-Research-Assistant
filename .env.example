# ===== LLM providers — all free, no credit card. Set at least ONE; more = more headroom. =====
# Google AI Studio (recommended primary): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (very fast): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (":free" models): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# NVIDIA NIM (build.nvidia.com): https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Mistral "Experiment" plan (phone verification, no card): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Order providers are tried in (unconfigured ones are skipped automatically)
PROVIDER_ORDER=gemini,groq,openrouter,nvidia,mistral

# Optional: override the comma-separated model fallback lists (defaults in ai_core/config.py).
# Check what your keys can use with:  python scripts/check_providers.py --models
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash
# GEMINI_STRONG_MODELS=gemini-2.5-flash,gemini-3.5-flash
# GROQ_FAST_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
# GROQ_STRONG_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# ===== Search — everything works keyless; these keys raise quality/limits =====
# Tavily, 1,000 free searches/month: https://app.tavily.com
TAVILY_API_KEY=
# Jina Reader (optional, higher rate limit): https://jina.ai/api-dashboard
JINA_API_KEY=
# Semantic Scholar (optional; keyless pool is often rate limited): https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# Optional: puts OpenAlex requests in the faster "polite pool"
CONTACT_EMAIL=

# ===== App =====
# Generate with:  chainlit create-secret
CHAINLIT_AUTH_SECRET=
# Owner accounts: always checked against these hashes, reserved so nobody else can register the
# name, unlimited usage, and they survive redeploys. Generate with:  python scripts/create_account.py
# Format: username:scrypt$...  (comma-separate several accounts)
AUTH_USERS=
# true: anyone can create their own account (chats stay private to each user)
# false: only the AUTH_USERS accounts can log in (invite-only)
ALLOW_SIGNUP=true
# Research runs per day for non-owner accounts (Deep counts as 2; follow-ups are free). 0 = unlimited
DAILY_RESEARCH_LIMIT=10
# Secret for the REST API (/api/research, /api/providers), sent as the X-API-Key header.
# Leave empty to disable the REST API entirely (the web UI does not need it).
API_KEY=
# Fact-check → rewrite cycles
MAX_REVISIONS=1
